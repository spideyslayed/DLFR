APP_NAME=DLFR API
DATABASE_URL=sqlite:///./dlfr.db
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_BEFORE_USE
JWT_EXPIRE_MINUTES=720
# Only needed when creating an owner for a brand-new database. Keep this private.
OWNER_SETUP_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_20_CHARACTERS
CORS_ORIGINS=http://localhost:5173
# Optional: data.gov.in API key for official published mandi price lookups.
MANDI_API_KEY=
# Optional email reports: fill all SMTP fields + REPORT_RECIPIENT_EMAIL to enable schedules.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
REPORT_RECIPIENT_EMAIL=
REPORT_TIMEZONE=Asia/Kolkata
DAILY_REPORT_TIME=20:00
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_TIME=08:00
